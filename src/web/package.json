{
  "name": "rando-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "precheck": "paraglide-js compile --outdir ./src/lib/paraglide --project ./project.inlang",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prebuild": "paraglide-js compile --outdir ./src/lib/paraglide --project ./project.inlang",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "machine-translate": "inlang machine translate --project project.inlang",
    "lint": "npx eslint . && npx prettier --check .",
    "format": "npx prettier --write .",
    "import-sprites": "npx tsx ./tools/sprite-importer/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "rando:version:create": "npx tsx tools/version-manager/index.ts",
    "rando:version:create:all": "npx tsx tools/version-manager/batch.ts"
  },
  "bin": {},
  "engines": {
    "node": ">=18"
  },
  "eslintConfig": {},
  "prettier": {},
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@inlang/cli": "^3.0.0",
    "@inlang/paraglide-js": "2.0.12",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/svelte": "^5.2.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22",
    "@types/pngjs": "^6.0.5",
    "@types/yargs": "^17.0.33",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^3.0.0",
    "fs-extra": "^11.3.0",
    "globals": "^16.0.0",
    "jsdom": "^24.1.3",
    "mdsvex": "^0.12.3",
    "pngjs": "^7.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.2.6",
    "vitest": "^2.0.5",
    "yargs": "^18.0.0"
  },
  "dependencies": {
    "bps": "^2.0.1",
    "@inlang/paraglide-js": "^2.0.0",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@maseya/z3pr": "^1.0.1",
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "better-sqlite3": "^11.8.0",
    "drizzle-orm": "^0.40.0",
    "flowbite-svelte": "^1.0.5",
    "localforage": "^1.10.0",
    "lucia": "^3.2.2",
    "nanoid": "^5.1.5",
    "oslo": "^1.2.1",
    "simple-git": "^3.24.0",
    "zod": "^3.25.76"
  }
}

# Docker Compose configuration
# Copy this file to .env and customize for your deployment

# Domain name for your deployment (required for Traefik/Let's Encrypt)
DOMAIN=randomizer.example.com

# Email for Let's Encrypt certificate notifications
TRAEFIK_ACME_EMAIL=admin@example.com

# Docker images (for production deployment using pre-built images)
API_IMAGE=ghcr.io/alttpr/csrando-api:latest
FRONTEND_IMAGE=ghcr.io/alttpr/rando-web-frontend:latest

# Base URL for sprite images (optional, defaults to https://alttpr.com/sprites)
PUBLIC_SPRITES_BASE_URL=https://alttpr.com/sprites

@page "/configure"
@rendermode InteractiveServer
@using RandomizerWeb.Components.Helpers
@using Randomizer.Graph

<h3>Create new game</h3>

<h4>Settings</h4>
<div class="container settings-container mt-4">
    
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text" id="seedLabel">Seed</span>
                    </div>
                    <input type="number" id="seed" class="form-control" @bind="@Seed" aria-describedby="seedLabel" />
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <EnumDropdown TEnum="GoalOption" @bind-SelectedValue="@Goal" Label="Goal" />
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-md-6">
            <EnumDropdown TEnum="StateOption" @bind-SelectedValue="@State" Label="State" />
        </div>
        <div class="col-md-6">
            <EnumDropdown TEnum="AccessibilityOption" @bind-SelectedValue="@Accessibility" Label="Accessibility" />
        </div>
    </div>

    <div class="row mt-3">
        <div class="col text-center">
            <button class="btn btn-primary" @onclick="GenerateGame">Generate Game</button>
        </div>
    </div>
</div>





@code 
{
    private int Seed { get; set; }
    private GoalOption Goal { get; set; }
    private StateOption State { get; set; }
    private AccessibilityOption Accessibility { get; set; }

    private void GenerateGame()
    {
        var worldConfig = new WorldConfig() 
            {
                Goal = Goal,
                State = State,
                Accessibility = Accessibility
            };

        var randomizer = new Randomizer([worldConfig], Seed);
        randomizer.Randomize();
    }
}

@page "/configure"
@rendermode InteractiveServer
@using RandomizerWeb.Components.Helpers
@using RandomizerWeb.Components.Components
@using System.Runtime.InteropServices

@using static Randomizer.Graph.GoalOption
@using static Randomizer.Graph.StateOption
@using static Randomizer.Graph.AccessibilityOption


<h3>Create new game</h3>
<p>@versionString</p>

<div class="container settings-container mt-4">    
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text" id="seedLabel">Seed (0 = Random)</span>
                    </div>
                    <input type="number" id="seed" class="form-control" @bind="@Seed" aria-describedby="seedLabel" />
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <EnumDropdown TEnum="Randomizer.Graph.GoalOption" @bind-SelectedValue="@Goal" Label="Goal" Default=Ganon Deny=[Pedestal,FastGanon,Trifecta,Dungeons] />
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-md-6">
            <EnumDropdown TEnum="Randomizer.Graph.StateOption" @bind-SelectedValue="@State" Label="State" Default=Open Deny=[Retro,Standard,Inverted] />
        </div>
        <div class="col-md-6">
            <EnumDropdown TEnum="Randomizer.Graph.AccessibilityOption" @bind-SelectedValue="@Accessibility" Label="Accessibility" Default=Items Deny=[None,Locations] />
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-md-6">
            <EnumDropdown TEnum="CrystalsOption" @bind-SelectedValue="@TowerCrystals" Label="Tower Crystals" Default=CrystalsOption.Seven Deny=[] />
        </div>
        <div class="col-md-6">
            <EnumDropdown TEnum="CrystalsOption" @bind-SelectedValue="@GanonCrystals" Label="Ganon Crystals" Default=CrystalsOption.Seven Deny=[] />
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-md-6">
            <EnumDropdown TEnum="BossesOption" @bind-SelectedValue="@SMBosses" Label="SM Bosses" Default=BossesOption.Four Deny=[] />
        </div>
        <div class="col-md-6">
            <EnumDropdown TEnum="TriforcesOption" @bind-SelectedValue="@Triforces" Label="Z1 Triforces" Default=TriforcesOption.Eight Deny=[] />
        </div>
    </div>

    <div class="row mt-3">
        <div class="col text-center">
            <button class="btn btn-primary" @onclick="GenerateGame">Generate Game</button>
        </div>
    </div>
</div>

<SpinnerDialog IsVisible="isLoading" />

<Seed Rando="@Rando" />

@code 
{
    private enum CrystalsOption : int
    {
        Random = -1,
        Zero = 0,
        One = 1,
        Two = 2,
        Three = 3,
        Four = 4,
        Five = 5,
        Six = 6,
        Seven = 7,
    }

    private enum BossesOption : int
    {
        Random = -1,
        Zero = 0,
        One = 1,
        Two = 2,
        Three = 3,
        Four = 4,
        Five = 5,
        Six = 6,
        Seven = 7,
    }

    private enum TriforcesOption : int
    {
        Random = -1,
        Zero = 0,
        One = 1,
        Two = 2,
        Three = 3,
        Four = 4,
        Five = 5,
        Six = 6,
        Seven = 7,
        Eight = 8,
    }

    private int Seed { get; set; } = 0;
    private Randomizer.Graph.GoalOption Goal { get; set; } = Ganon;
    private Randomizer.Graph.StateOption State { get; set; } = Open;
    private Randomizer.Graph.AccessibilityOption Accessibility { get; set; } = Items;

    private CrystalsOption TowerCrystals { get; set; } = CrystalsOption.Seven;
    private CrystalsOption GanonCrystals { get; set; } = CrystalsOption.Seven;
    private BossesOption SMBosses { get; set; } = BossesOption.Four;
    private TriforcesOption Triforces { get; set; } = TriforcesOption.Eight;

    private Randomizer.Graph.Randomizer? Rando { get; set; }

    private bool isLoading = false;
    private string versionString = Randomizer.Graph.Randomizer.GetVersionString();

    private async void GenerateGame()
    {
        var rnd = new Random();
        isLoading = true;
        StateHasChanged();
        await Task.Yield();

        if (Seed == 0)
            Seed = new Random().Next(Int32.MinValue, Int32.MaxValue);

        var worldConfig = new Randomizer.Graph.WorldConfig()
            {
                Goal = Goal,
                State = State,
                Accessibility = Accessibility,
                CrystalsTower = TowerCrystals == CrystalsOption.Random ? rnd.Next(0, 7) : (int)TowerCrystals,
                CrystalsGanon = GanonCrystals == CrystalsOption.Random ? rnd.Next(0, 7) : (int)GanonCrystals,
                SMBosses = SMBosses == BossesOption.Random ? rnd.Next(0, 4) : (int)SMBosses,
                Z1Triforces = Triforces == TriforcesOption.Random ? rnd.Next(0, 8) : (int)Triforces,
            };

        // Set this if we're running as a published app
        if (RuntimeInformation.IsOSPlatform(OSPlatform.Linux))
        {
            // Get the path to the executing assembly
            var assemblyPath = System.Reflection.Assembly.GetExecutingAssembly().Location;
            Randomizer.Graph.YamlReader.DataRoot = Path.Combine(Path.GetDirectoryName(assemblyPath), "Graph/data/");
        }
        
        var randomizer = new Randomizer.Graph.Randomizer([worldConfig], Seed);
        randomizer.Randomize();

        Rando = randomizer;

        isLoading = false;
        StateHasChanged();

    }
}
